<script>
    function updateCartSummary() {
        fetch('/Cart/GetSummary')
            .then(response => response.json())
            .then(data => {
                const panel = document.getElementById('floating-cart');
                const countEl = document.getElementById('cart-count');
                const totalEl = document.getElementById('cart-total');

                // Проверка на null, чтобы анализатор не ругался
                if (panel && countEl && totalEl) {
                    if (data.TotalItems > 0) {
                        countEl.textContent = data.TotalItems;
                        totalEl.textContent = data.TotalAmount.toLocaleString('ru-RU');
                        panel.classList.add('visible');
                    } else {
                        panel.classList.remove('visible');
                    }
                }
            });
    }

    document.addEventListener('DOMContentLoaded', updateCartSummary);
</script>