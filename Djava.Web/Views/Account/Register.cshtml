@model DjavaLib.Models.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4">Регистрация</h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label>Логин</label>
                    <input asp-for="Login" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Пароль</label>
                    <div class="input-group">
                        <input asp-for="Password" id="passwordField" type="password" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('passwordField')">👁</button>
                    </div>
                </div>

                <div class="mb-3">
                    <label>Подтверждение пароля</label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" id="confirmField" type="password" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('confirmField')">👁</button>
                    </div>
                </div>

                <div class="mb-3">
                    <label>ФИО</label>
                    <input asp-for="FullName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Контактные данные (телефон или email)</label>
                    <input asp-for="ContactInfo" class="form-control" placeholder="+7 (999) 999-99-99 или email@mail.ru" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Зарегистрироваться</button>
            </form>

            <p class="mt-3 text-center">
                <a asp-action="Login">Уже есть аккаунт? Войти</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(id) {
            var field = document.getElementById(id);
            if (field.type === 'password') {
                field.type = 'text';
            } else {
                field.type = 'password';
            }
        }
    </script>
}