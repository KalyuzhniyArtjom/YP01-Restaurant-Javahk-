@{
    ViewData["Title"] = "Ресторан «Джавахк»";
    var login = Context.Session.GetString("Login");
    var fullName = Context.Session.GetString("FullName");
    var role = Context.Session.GetString("Role");
    var dishes = ViewBag.PopularDishes as List<DjavaLib.Models.Dish>;
}

<style>
    /* Убираем серые полосы по бокам */
    html, body {
        background-color: #ffffff !important;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* --- Стили для логотипа в навбаре --- */
    .navbar-brand img {
        height: 45px; /* Высота логотипа в шапке */
        width: auto;
        margin-right: 10px;
        vertical-align: middle;
    }

    .navbar-brand {
        display: flex;
        align-items: center;
        font-size: 1.5rem;
    }

    /* === БАННЕР === */
    .hero {
        background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.7)), url('/images/fon.png');
        background-size: cover;
        background-position: center;
        color: #fff;
        padding: 120px 20px;
        text-align: center;
    }

        .hero .logo-img {
            height: 140px;
            margin-bottom: 20px;
            filter: drop-shadow(0px 6px 10px rgba(0,0,0,0.6));
        }

        .hero h1 {
            font-size: 3.5rem;
            font-weight: 800;
            text-shadow: 2px 2px 5px rgba(0,0,0,0.8);
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 1.3rem;
            margin-bottom: 30px;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.8);
        }

    /* === КНОПКА ВК === */
    .vk-btn {
        background-color: #5a5a5a;
        color: #fff;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background-color 0.2s;
        margin-top: 20px;
    }

        .vk-btn:hover {
            background-color: #3a3a3a;
            color: #fff;
        }

        .vk-btn img {
            width: 24px;
            height: 24px;
        }

    /* === НАШИ ПРЕИМУЩЕСТВА === */
    .advantages-section {
        background-color: #ffffff;
        padding: 80px 0;
    }

    .advantages-title {
        text-align: center;
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 50px;
        color: #222;
    }

    .advantage-card {
        background: #fff;
        border-radius: 20px;
        padding: 40px 20px;
        text-align: center;
        transition: all 0.3s ease;
        height: 100%;
        border: 1px solid #f0f0f0;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border-top: 5px solid #b8a0a5;
    }

        .advantage-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(184, 160, 165, 0.2);
        }

        .advantage-card .icon {
            font-size: 3.5rem;
            margin-bottom: 20px;
            display: inline-block;
        }

        .advantage-card h5 {
            font-size: 1.3rem;
            font-weight: 800;
            color: #222;
            margin-bottom: 10px;
        }

        .advantage-card p {
            color: #666;
            font-size: 0.95rem;
            margin: 0;
        }

    /* === БЛЮДА МЕСЯЦА === */
    .section-title {
        text-align: center;
        font-size: 2.2rem;
        font-weight: 800;
        color: #222;
        margin-bottom: 40px;
        margin-top: 60px;
    }

    .dish-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        border: 1px solid #eaeaea;
    }

        .dish-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(184, 160, 165, 0.3);
            border-color: #b8a0a5;
        }

    .dish-photo {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-bottom: 1px solid #eaeaea;
    }

    .dish-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .dish-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: #222;
        margin-bottom: 8px;
    }

    .dish-desc {
        color: #555;
        font-size: 0.9rem;
        margin-bottom: 15px;
        flex-grow: 1;
    }

    .dish-price {
        font-size: 1.6rem;
        font-weight: 900;
        color: #8a6f75;
        margin-bottom: 15px;
    }

    /* Кнопки */
    .btn-dish {
        background-color: #b8a0a5;
        color: #fff;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 700;
        transition: background 0.3s;
        text-align: center;
        text-decoration: none;
        display: block;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

        .btn-dish:hover {
            background-color: #9a8288;
            color: #fff;
        }

    .btn-dish-outline {
        background-color: transparent;
        color: #8a6f75;
        border: 2px solid #8a6f75;
        padding: 10px;
        border-radius: 8px;
        font-weight: 700;
        transition: all 0.3s;
        text-align: center;
        text-decoration: none;
        display: block;
        font-size: 0.85rem;
        text-transform: uppercase;
    }

        .btn-dish-outline:hover {
            background-color: #8a6f75;
            color: #fff;
        }

    /* === ОТЗЫВЫ === */
    .review-card {
        background: #fff;
        border-left: 5px solid #b8a0a5;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .stars {
        color: #ffc107;
        font-size: 1.2rem;
        margin-bottom: 10px;
    }

    /* === ПОДВАЛ === */
    footer {
        background: #1a1a1a;
        color: #fff;
        padding: 60px 0 20px;
        margin-top: 80px;
    }

        footer h5 {
            color: #b8a0a5;
            margin-bottom: 20px;
        }

        footer a {
            color: #ddd;
            text-decoration: none;
            transition: 0.2s;
        }

            footer a:hover {
                color: #b8a0a5;
            }
</style>

<!-- НАВБАР -->
<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #1a1a1a;">
    <div class="container d-flex align-items-center justify-content-between">
        <!-- ЛОГОТИП В НАВБАРЕ -->
        <a class="navbar-brand fw-bold text-white" href="/">
            <img src="~/images/LogoDjava.png" alt="Логотип" />
            Джавахк
        </a>

        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link active" asp-controller="Home" asp-action="Index">Главная</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Menu">Меню</a>
            </li>
        </ul>
        <div class="d-flex align-items-center">
            @if (login == null)
            {
                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                    👤 Войти
                </a>
            }
            else
            {
                <span class="text-light me-3">👤 @fullName</span>
                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">
                    Выйти
                </a>
            }
        </div>
    </div>
</nav>

<!-- ГЛАВНЫЙ БАННЕР -->
<div class="hero">
    <div class="container">
        <img src="~/images/LogoDjava.png" alt="Ресторан «Джавахк»" class="logo-img" />
        <h1>Ресторан «Джавахк»</h1>
        <p>Традиционная восточная и узбекская кухня</p>

        @if (login == null)
        {
            <a asp-controller="Home" asp-action="Menu" class="btn btn-light btn-lg me-2 fw-bold text-dark">Посмотреть меню</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg fw-bold">
                Зарегистрироваться
            </a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Menu" class="btn btn-light btn-lg fw-bold text-dark">Посмотреть меню</a>
        }

        <div>
            <a href="https://vk.ru/id636806687" target="_blank" class="vk-btn">
                <img src="~/images/vk.png" alt="ВК" />
                Наш сайт ВКонтакте
            </a>
        </div>
    </div>
</div>

<!-- ПРЕИМУЩЕСТВА -->
<div class="advantages-section">
    <div class="container">
        <h2 class="advantages-title">Наши преимущества</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="advantage-card">
                    <div class="icon">🚚</div>
                    <h5>Быстрая доставка</h5>
                    <p>Доставим ваш заказ в течение 60 минут</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="advantage-card">
                    <div class="icon">🥘</div>
                    <h5>Свежие блюда</h5>
                    <p>Готовим только из натуральных продуктов</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="advantage-card">
                    <div class="icon">⭐</div>
                    <h5>Высокий сервис</h5>
                    <p>Заботимся о каждом нашем госте</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- БЛЮДА МЕСЯЦА -->
<div class="container">
    <h2 class="section-title">Блюда месяца</h2>
    <div class="row g-4">
        @if (dishes != null)
        {
            foreach (var dish in dishes.Take(6))
            {
                <div class="col-md-4 col-sm-6">
                    <div class="dish-card">
                        @if (!string.IsNullOrEmpty(dish.PhotoPath))
                        {
                            <img src="@dish.PhotoPath" alt="@dish.Name" class="dish-photo" />
                        }
                        else
                        {
                            <img src="~/images/no-photo.png" alt="Нет фото" class="dish-photo" />
                        }
                        <div class="dish-body">
                            <h5 class="dish-title">@dish.Name</h5>
                            <p class="dish-desc">@dish.Description</p>
                            <div class="dish-price">@(Convert.ToDecimal(dish.Price).ToString("N2")) ₽</div>

                            @if (login != null)
                            {
                                <a href="#" class="btn-dish">Добавить в корзину</a>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn-dish-outline">
                                    Добавить в корзину
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- ОТЗЫВЫ -->
<div class="container mt-5">
    <h2 class="section-title">Отзывы наших гостей</h2>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p class="mt-2 mb-1">Очень вкусный плов, доставили быстро!</p>
                <small class="text-muted">— Андрей Кузнецов, 15.09.2026</small>
            </div>
        </div>
        <div class="col-md-6">
            <div class="review-card">
                <div class="stars">★★★★☆</div>
                <p class="mt-2 mb-1">Всё понравилось, но лагман был слегка острым.</p>
                <small class="text-muted">— Ольга Смирнова, 18.09.2026</small>
            </div>
        </div>
        <div class="col-md-6">
            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p class="mt-2 mb-1">Фирменный салат — просто восторг!</p>
                <small class="text-muted">— Пётр Иванов, 20.09.2026</small>
            </div>
        </div>
        <div class="col-md-6">
            <div class="review-card">
                <div class="stars">★★★★★</div>
                <p class="mt-2 mb-1">Обслуживание на высоте, обязательно вернусь.</p>
                <small class="text-muted">— Мария Петрова, 22.09.2026</small>
            </div>
        </div>
    </div>
</div>

<!-- ПОДВАЛ -->
<footer>
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-4">
                <h5>Ресторан «Джавахк»</h5>
                <p class="small text-muted">Традиционная восточная и узбекская кухня. Готовим с душой для каждого гостя.</p>
            </div>
            <div class="col-md-4 mb-4">
                <h5>Контакты</h5>
                <p class="small mb-1 text-muted">📍 1-й переулок Металлистов, дом 3, Торжок</p>
                <p class="small mb-1 text-muted">📞 +7 (910) 539-18-08</p>
                <p class="small mb-1 text-muted">🕒 Ежедневно с 9:00 до 22:00</p>
            </div>
            <div class="col-md-4 mb-4">
                <h5>Разделы</h5>
                <p class="small mb-1"><a asp-controller="Home" asp-action="Index">🏠 Главная</a></p>
                <p class="small mb-1"><a asp-controller="Home" asp-action="Menu">🍽 Меню</a></p>
                <p class="small mb-0"><a asp-controller="Account" asp-action="Login">👤 Личный кабинет</a></p>
            </div>
        </div>
        <hr style="border-color: #333;" />
        <div class="text-center small text-muted">© 2026 Ресторан «Джавахк» · Все права защищены</div>
    </div>
</footer>